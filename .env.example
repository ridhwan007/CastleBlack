# ============================================================
# AIPTT Environment Variables — Copy to .env and fill values
# ============================================================

# --- Anthropic AI (REQUIRED) ---
# Your Anthropic API key — get one at https://console.anthropic.com
AIPTT_AI_API_KEY=sk-ant-api03-REPLACE_ME

# --- Encryption (REQUIRED) ---
# AES-256 master key: 64 hex characters (32 bytes)
# Generate: python -c "import os,binascii; print(binascii.hexlify(os.urandom(32)).decode())"
AIPTT_MASTER_KEY=REPLACE_WITH_64_HEX_CHARS

# --- Audit HMAC (REQUIRED) ---
# Any strong secret string for HMAC-chaining the audit log
AIPTT_AUDIT_KEY=REPLACE_WITH_STRONG_SECRET

# --- Database (OPTIONAL — defaults to SQLite) ---
# Uncomment for PostgreSQL production deployment:
# POSTGRESQL_URL=postgresql://aiptt_user:password@localhost:5432/aiptt

# --- Neo4j Knowledge Graph (OPTIONAL — defaults to bolt://localhost:7687) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=REPLACE_ME
